# انسخي هذا الملف إلى luna.env فقط إن احتجتِ تغيير الإعدادات الافتراضية.
# Copy to luna.env only if you need to change defaults (read by index.php).

# مجلد التخزين (افتراضيًا data/ بجانب index.php)
# LUNA_DATA_DIR=/home/user/htdocs/data

# (اختياري) تمرير الطلبات إلى خدمة Next.js تعمل على نفس السيرفر.
# اتركيه فارغًا أو معلّقًا على استضافات PHP فقط (aeonfree) — سيعمل محرّك PHP مباشرة.
# LUNA_NODE_URL=http://127.0.0.1:3000
